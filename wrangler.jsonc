{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openhr",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openhr-db",
      "database_id": "local-openhr-db",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "openhr-uploads"
    }
  ],
  "vars": {
    "ENVIRONMENT": "development",
    "PURELYMAIL_DOMAIN": "company.id",
    "PURELYMAIL_FROM_ADDRESS": "hr@company.id",
    "PURELYMAIL_API_BASE_URL": "https://purelymail.com",
    "APP_URL": "http://localhost:8787",
    "JWT_SECRET": "openhr-secret-key-change-in-production-min-32-chars-long"
  }
}
